---
import type { CollectionEntry } from "astro:content";
import { getCategoryHref } from "../utils/categories";
import { withBase } from "../utils/paths";
import TechTag from "./TechTag.astro";

interface Props {
  post: CollectionEntry<"blog">;
  compact?: boolean;
}

const { post, compact = false } = Astro.props;
const date = post.data.date.toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" });
---

<article class:list={["group border-b border-[#ded6c9] py-6 transition", compact ? "last:border-b-0" : ""]}>
  <div class="mb-3 flex flex-wrap items-center gap-3 text-sm text-[#6f6a60]">
    <time datetime={post.data.date.toISOString()}>{date}</time>
    <span>·</span>
    <a class="quiet-link" href={getCategoryHref(post.data.category)}>{post.data.category}</a>
  </div>
  <a href={withBase(`/blog/${post.id}`)} class="block">
    <h2 class="text-2xl font-bold leading-tight text-[#22201c] transition group-hover:text-[#146c68]">{post.data.title}</h2>
  </a>
  <p class="mt-3 max-w-3xl text-sm leading-7 text-[#5f5a52]">{post.data.description}</p>
  <div class="mt-4 flex flex-wrap gap-2">
    {post.data.tags.map((tag) => <TechTag label={tag} />)}
  </div>
</article>
