---
import { getCollection } from "astro:content";
import BlogCard from "../components/BlogCard.astro";
import Hero from "../components/Hero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCategoryHref } from "../utils/categories";
import { withBase } from "../utils/paths";

const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const posts = allPosts.slice(0, 10);
const projects = (await getCollection("projects"))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const categories = [...new Set(allPosts.map((post) => post.data.category))];
---

<BaseLayout title="首页">
  <Hero />

  <section class="grid gap-8 py-10 lg:grid-cols-[1fr_18rem]">
    <div class="blog-shell rounded-lg px-6">
      <div class="flex items-end justify-between gap-4 border-b border-[#ded6c9] py-5">
        <div>
          <p class="text-sm font-medium text-[#146c68]">最新文章</p>
          <h2 class="mt-1 text-2xl font-bold text-[#22201c]">近期写作</h2>
        </div>
        <a href={withBase("/blog")} class="quiet-link text-sm">全部文章</a>
      </div>
      {posts.map((post) => <BlogCard post={post} compact />)}
    </div>

    <aside class="space-y-4">
      <section class="blog-shell rounded-lg p-5">
        <h2 class="text-base font-bold text-[#22201c]">作者</h2>
        <p class="mt-3 text-sm leading-7 text-[#5f5a52]">
          Kong，记录大模型学习、工程项目和论文阅读。未来方向是大模型开发。
        </p>
      </section>
      <section class="blog-shell rounded-lg p-5">
        <h2 class="text-base font-bold text-[#22201c]">文章分类</h2>
        <div class="mt-4 flex flex-wrap gap-2">
          {categories.map((category) => (
            <a class="rounded-md border border-[#ded6c9] bg-white px-3 py-1 text-sm text-[#5f5a52] transition hover:border-[#146c68]/40 hover:text-[#146c68]" href={getCategoryHref(category)}>
              {category}
            </a>
          ))}
        </div>
      </section>
      <section class="blog-shell rounded-lg p-5">
        <h2 class="text-base font-bold text-[#22201c]">写作方向</h2>
        <ul class="mt-3 space-y-2 text-sm text-[#5f5a52]">
          <li>大模型基础原理</li>
          <li>RAG 与知识库应用</li>
          <li>LoRA 微调实验</li>
          <li>LLM Agent 工程实践</li>
        </ul>
      </section>
    </aside>
  </section>

  <section class="py-4">
    <div class="mb-6 flex items-end justify-between gap-4">
      <div>
        <p class="text-sm font-medium text-[#9a5b1f]">项目记录</p>
        <h2 class="mt-1 text-2xl font-bold text-[#22201c]">近期项目</h2>
      </div>
      <a href={withBase("/projects")} class="quiet-link text-sm">全部项目</a>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</BaseLayout>
