---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="联系" description="Kong 的联系方式与交流入口。">
  <section class="border-b border-[#ded6c9] py-10">
    <p class="text-sm font-medium text-[#9a5b1f]">联系方式</p>
    <h1 class="mt-3 text-4xl font-black text-[#22201c]">联系 Kong</h1>
    <p class="mt-4 max-w-2xl text-[#5f5a52]">欢迎交流大模型工程、论文阅读、项目合作和学习路线。</p>
  </section>

  <section class="mt-8 grid gap-4 md:grid-cols-3">
    {[
      ["邮箱", "your-email@example.com"],
      ["GitHub", "https://github.com/your-name"],
      ["方向", "LLM / RAG / Agent / LoRA"],
    ].map(([title, value]) => (
      <div class="blog-shell rounded-lg p-5">
        <h2 class="text-sm text-[#6f6a60]">{title}</h2>
        <p class="mt-3 break-words text-lg font-semibold text-[#22201c]">{value}</p>
      </div>
    ))}
  </section>
</BaseLayout>
