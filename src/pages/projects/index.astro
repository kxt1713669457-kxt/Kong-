---
import { getCollection } from "astro:content";
import ProjectCard from "../../components/ProjectCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout title="项目" description="Kong 的大模型相关项目作品与工程实践记录。">
  <section class="border-b border-[#ded6c9] py-10">
    <p class="text-sm font-medium text-[#9a5b1f]">项目作品</p>
    <h1 class="mt-3 text-4xl font-black text-[#22201c]">项目记录</h1>
    <p class="mt-4 max-w-2xl text-[#5f5a52]">这些项目会逐步从概念演示走向真实开发，记录需求、架构、实现、评测和复盘。</p>
  </section>
  <section class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {projects.map((project) => <ProjectCard project={project} />)}
  </section>
</BaseLayout>
