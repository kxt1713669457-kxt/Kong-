---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="研究" description="Kong 的论文阅读、实验计划与研究记录。">
  <section class="border-b border-[#ded6c9] py-10">
    <p class="text-sm font-medium text-[#334e80]">研究记录</p>
    <h1 class="mt-3 text-4xl font-black text-[#22201c]">论文、实验与问题清单</h1>
    <p class="mt-4 max-w-2xl text-[#5f5a52]">这里用于沉淀论文阅读、实验假设、复现实验和阶段性总结，帮助学习过程形成连续的证据链。</p>
  </section>
  <section class="mt-8 grid gap-4 md:grid-cols-2">
    {[
      ["论文阅读", "精读 Transformer、RAG、PEFT、Agent 和评测体系相关论文。"],
      ["实验设计", "记录数据集、指标、基线、变量控制和实验风险。"],
      ["复现清单", "把关键论文方法拆成可实现模块，记录环境和踩坑点。"],
      ["阶段总结", "按月回顾学习产出、代码资产和下一步研究问题。"],
    ].map(([title, body]) => (
      <div class="blog-shell rounded-lg p-5">
        <h2 class="text-lg font-bold text-[#22201c]">{title}</h2>
        <p class="mt-3 text-sm leading-7 text-[#5f5a52]">{body}</p>
      </div>
    ))}
  </section>
</BaseLayout>
