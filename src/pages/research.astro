---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/paths";

const topics = [
  { title: "论文与资料", label: "阅读线索", body: "围绕运动想象数据集、RAG、HyDE 与 EEG 基础模型，区分论文结论、官方说明和项目自己的运行结果。", links: [
    { label: "CBraMod 论文 ↗", href: "https://arxiv.org/abs/2412.07236" },
    { label: "HyDE 论文 ↗", href: "https://arxiv.org/abs/2212.10496" },
    { label: "EEG 模型学习记录 →", href: withBase("/blog/eeg-learning-08-model/") },
  ]},
  { title: "实验设计与评测", label: "比较方法", body: "固定语料、题目和编码条件，比较 dense、sparse、HyDE 与重排；分别考察证据覆盖、排序、回答支持和任务完成。", links: [
    { label: "切块与参数比较 →", href: withBase("/blog/eeg-learning-04-chunking/") },
    { label: "检索与重排 →", href: withBase("/blog/eeg-learning-05-retrieval/") },
  ]},
  { title: "工程复盘", label: "问题与边界", body: "记录文档来源、导入幂等、工具调用与任务状态；保留 HyDE 生成错误、候选漏召回等失败案例和验证范围。", links: [
    { label: "文档解析与导入 →", href: withBase("/blog/eeg-learning-03-ingestion/") },
    { label: "证据与引用复核 →", href: withBase("/blog/eeg-learning-06-evidence/") },
  ]},
  { title: "阶段总结", label: "下一步", body: "继续补充分层评测、样本适配与任务恢复证据；分类预测需要真实数值输入和适配条件，不以模型分数冒充准确率。", links: [
    { label: "一个月学习复盘 →", href: withBase("/blog/eeg-learning-09-workbench/") },
    { label: "查看项目全貌 →", href: withBase("/projects/eeg-knowledge-agent/") },
  ]},
];
---

<BaseLayout title="研究" description="Kong 的 EEG 智库 Agent 研究、论文阅读、实验比较与阶段复盘。">
  <section class="border-b border-[#ded6c9] py-10">
    <p class="text-sm font-medium text-[#334e80]">研究记录</p>
    <h1 class="mt-3 text-4xl font-black text-[#22201c]">论文、实验与问题清单</h1>
    <p class="mt-4 max-w-3xl leading-8 text-[#5f5a52]">从 EEG 运动想象研究出发，整理资料检索、Agent 工具与脑电模型的学习过程，记录设计依据、验证结果和尚未解决的问题。</p>
  </section>

  <section class="blog-shell mt-8 rounded-lg p-6 sm:p-8">
    <div class="flex flex-wrap items-start justify-between gap-5">
      <div class="max-w-3xl">
        <p class="text-sm font-medium text-[#146c68]">当前研究项目</p>
        <h2 class="mt-2 text-2xl font-bold text-[#22201c]">EEG 智库 Agent</h2>
        <p class="mt-3 text-sm leading-7 text-[#5f5a52]">围绕论文与数据集构建可追溯 RAG，并通过受控 Agent 调用 EEG 模型或解释已有产物。项目在已有框架上完善，学习与实现过程有带教协助。</p>
      </div>
      <a class="rounded-md bg-[#146c68] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#0f5653]" href={withBase("/projects/eeg-knowledge-agent/")}>项目详情 →</a>
    </div>
    <div class="mt-6 flex flex-wrap gap-2 text-xs font-medium text-[#405a56]">
      {["文献与数据", "多路检索", "证据复核", "受控工具", "EEG 模型"].map((item) => <span class="rounded-md border border-[#d4e1db] bg-[#edf3f1] px-3 py-2">{item}</span>)}
    </div>
  </section>

  <section class="mt-8 grid gap-4 md:grid-cols-2" aria-label="研究主题">
    {topics.map((topic) => (
      <article class="blog-shell rounded-lg p-6">
        <p class="text-xs font-semibold tracking-wide text-[#9a5b1f]">{topic.label}</p>
        <h2 class="mt-2 text-xl font-bold text-[#22201c]">{topic.title}</h2>
        <p class="mt-3 text-sm leading-7 text-[#5f5a52]">{topic.body}</p>
        <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm">{topic.links.map((link) => <a class="quiet-link" href={link.href}>{link.label}</a>)}</div>
      </article>
    ))}
  </section>

  <section class="mt-8 border-t border-[#ded6c9] py-8">
    <h2 class="text-xl font-bold text-[#22201c]">目前值得继续追问的问题</h2>
    <ul class="mt-4 space-y-2 text-sm leading-7 text-[#5f5a52] list-disc pl-5">
      <li>一条回答的所有关键条件是否都能回到同一版本的原文核对？</li>
      <li>候选覆盖和排序分别带来什么变化，效果提升是否能在未参与调参的题目上复现？</li>
      <li>脑电样本与模型训练约定是否一致，模型输出可以支持什么结论？</li>
    </ul>
    <p class="mt-4 text-sm leading-7 text-[#6f6a60]">这里记录的是研究与学习过程；页面中涉及的实验结论以各篇文章说明的时间、样本和条件为准。</p>
  </section>
</BaseLayout>
