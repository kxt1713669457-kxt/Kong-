---
import { getCollection } from "astro:content";
import BlogCard from "../../../components/BlogCard.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { categorySlugMap, getCategoryNameBySlug } from "../../../utils/categories";
import { withBase } from "../../../utils/paths";

export async function getStaticPaths() {
  return Object.entries(categorySlugMap).map(([category, slug]) => ({
    params: { slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const posts = (await getCollection("blog", ({ data }) => !data.draft && data.category === category)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const categoryName = getCategoryNameBySlug(Astro.params.slug ?? "") ?? category;
---

<BaseLayout title={`${categoryName}分类`} description={`Kong 的${categoryName}分类文章。`}>
  <section class="border-b border-[#ded6c9] py-10">
    <a href={withBase("/blog")} class="quiet-link text-sm">返回全部文章</a>
    <p class="mt-6 text-sm font-medium text-[#146c68]">分类文章</p>
    <h1 class="mt-3 text-4xl font-black text-[#22201c]">{categoryName}</h1>
    <p class="mt-4 max-w-2xl text-[#5f5a52]">这个分类下共有 {posts.length} 篇文章。</p>
  </section>
  <section class="blog-shell mt-8 rounded-lg px-6">
    {posts.map((post) => <BlogCard post={post} compact />)}
  </section>
</BaseLayout>
