---
import { getCollection } from "astro:content";
import BlogCard from "../../components/BlogCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCategoryHref } from "../../utils/categories";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const categories = [...new Set(posts.map((post) => post.data.category))];
---

<BaseLayout title="文章" description="Kong 关于大模型学习、工程实践与论文阅读的技术文章。">
  <section class="border-b border-[#ded6c9] py-10">
    <p class="text-sm font-medium text-[#146c68]">文章归档</p>
    <h1 class="mt-3 text-4xl font-black text-[#22201c]">技术文章</h1>
    <p class="mt-4 max-w-2xl text-[#5f5a52]">这里按时间记录我的学习笔记、工程实践和论文阅读。文章使用 Markdown / MDX 编写，方便长期维护。</p>
    <div class="mt-6 flex flex-wrap gap-2">
      {categories.map((category) => (
        <a class="rounded-md border border-[#ded6c9] bg-white px-3 py-1 text-sm text-[#5f5a52] transition hover:border-[#146c68]/40 hover:text-[#146c68]" href={getCategoryHref(category)}>
          {category}
        </a>
      ))}
    </div>
  </section>
  <section class="blog-shell mt-8 rounded-lg px-6">
    {posts.map((post) => <BlogCard post={post} compact />)}
  </section>
</BaseLayout>
