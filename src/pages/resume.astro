---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="简历" description="Kong 的个人简历、技能栈与项目经历。">
  <section class="border-b border-[#ded6c9] py-10">
    <p class="text-sm font-medium text-[#146c68]">个人简历</p>
    <h1 class="mt-3 text-4xl font-black text-[#22201c]">Kong</h1>
    <p class="mt-4 max-w-2xl text-[#5f5a52]">未来方向是大模型开发，持续积累模型原理、工程系统和项目实践。</p>
  </section>

  <section class="mt-8 grid gap-4 lg:grid-cols-[0.75fr_1.25fr]">
    <aside class="blog-shell rounded-lg p-5">
      <h2 class="text-lg font-bold text-[#22201c]">技能栈</h2>
      <div class="mt-4 flex flex-wrap gap-2 text-sm text-[#5f5a52]">
        {["Python", "PyTorch", "Transformers", "LangChain", "Vector DB", "Astro", "TypeScript"].map((skill) => (
          <span class="rounded-md border border-[#ded6c9] bg-white px-3 py-1">{skill}</span>
        ))}
      </div>
    </aside>
    <div class="blog-shell rounded-lg p-5">
      <h2 class="text-lg font-bold text-[#22201c]">经历概览</h2>
      <div class="mt-5 space-y-5 text-[#5f5a52]">
        <div>
          <p class="font-semibold text-[#22201c]">大模型开发方向</p>
          <p class="mt-2 text-sm leading-7">关注大模型应用开发、RAG 系统、Agent 工具调用、参数高效微调与模型部署。</p>
        </div>
        <div>
          <p class="font-semibold text-[#22201c]">项目方向</p>
          <p class="mt-2 text-sm leading-7">构建可复现的大模型项目组合，用博客文章记录关键设计决策、实验数据和工程权衡。</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
